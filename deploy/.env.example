# Local demo: docker compose --env-file deploy/.env up --build -d
AMAN_BIND_ADDRESS=127.0.0.1
AMAN_PORT=8000
AMAN_PUBLIC_ORIGIN=http://127.0.0.1:8000
AMAN_COOKIE_SECURE=false
# Only the actual reverse proxy IP/CIDR is trusted. Never use *.
AMAN_TRUSTED_PROXY_IPS=127.0.0.1
# HTTPS deployment: set AMAN_PUBLIC_ORIGIN=https://your-domain.example
# and AMAN_COOKIE_SECURE=true; proxy must preserve Host and forward scheme.
# A remote proxy needs an explicitly configured reachable network/interface.
